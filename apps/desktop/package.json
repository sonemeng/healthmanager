{
  "name": "@healthmanager/desktop",
  "version": "0.1.9",
  "description": "Local-first family health records for Windows.",
  "author": "sonemeng",
  "private": true,
  "main": "build/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "tsup src/main.ts src/preload.ts --format cjs --target node22 --out-dir build --clean --external electron",
    "typecheck": "tsc --noEmit",
    "prepare-runtime": "tsx scripts/prepare-runtime.ts",
    "dist": "pnpm prepare-runtime && pnpm build && electron-builder --win nsis --x64 --publish never",
    "backup-personal-data": "tsx scripts/backup-personal-data.ts",
    "stage-personal-data": "tsx scripts/stage-personal-data.ts",
    "archive-personal-installer": "tsx scripts/archive-personal-installer.ts",
    "clear-personal-data": "tsx scripts/clear-personal-data.ts",
    "dist-personal": "pnpm prepare-runtime && pnpm stage-personal-data && pnpm build && electron-builder --win zip --x64 --publish never && pnpm archive-personal-installer && pnpm clear-personal-data"
  },
  "build": {
    "appId": "com.sonemeng.healthmanager",
    "productName": "HealthManager++",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "build/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../desktop-runtime/app",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../desktop-runtime/postgres",
        "to": "postgres",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "HealthManager++-Personal-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "HealthManager++-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "useZip": true,
      "artifactName": "HealthManager++-Personal-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "electron": "^40.4.2",
    "electron-builder": "^26.8.1",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
